{
  "manifest_version": 3,
  "name": "Open in Brave",
  "version": "1.0",
  "description": "Open the current YouTube video (or a link) in Brave.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in Brave"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open this video in Brave"
    }
  }
}